# Backend API base URL (Spring Boot). Leave unset to fall back to mock auth.
VITE_API_URL=http://localhost:8080/api/v1

# Force mock auth (localStorage-backed fake backend) even if VITE_API_URL is set.
# Useful for Sprint 2 while the real BE endpoints aren't ready yet.
VITE_USE_MOCK_AUTH=true

# Google OAuth Client ID (Google Cloud Console -> Credentials -> OAuth Client ID -> Web).
# Leave empty to hide the "Đăng nhập với Google" button.
VITE_GOOGLE_CLIENT_ID=
